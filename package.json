{
  "name": "mcp-local-llm",
  "version": "2.2.0",
  "description": "MCP server to connect Claude Desktop to local LLMs (Ollama, LM Studio) -- single canonical TypeScript implementation",
  "main": "dist/entrypoints/combined.js",
  "bin": {
    "mcp-local-llm": "dist/entrypoints/combined.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/entrypoints/combined.js",
    "start:ollama": "node dist/entrypoints/ollama.js",
    "start:lmstudio": "node dist/entrypoints/lmstudio.js",
    "dev": "tsx src/entrypoints/combined.ts",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "ollama",
    "lm-studio",
    "llm",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^7.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
