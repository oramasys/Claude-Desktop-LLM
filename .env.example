# Copy to .env (gitignored) or export these directly, for local development.

# Provider endpoints
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-mlx
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=qwen3.5-9b-mlx

# Which provider is active by default (ollama | lmstudio).
ACTIVE_PROVIDER=ollama

# Request timeout in milliseconds.
TIMEOUT=190000

# Security: local-first by default. Both must be set to permit a non-loopback
# provider URL (LAN/remote Ollama or LM Studio).
ALLOW_REMOTE_LLM=0
ALLOWED_LLM_HOSTS=

# Canonical endpoint-security authority. Claude-Desktop-LLM no longer performs
# SSRF/DNS/pinning/redirect/TLS policy itself; requests are executed through
# `python -m telos.bridge`. Override only when Telos is installed in another
# Python environment or exposed under a different module name.
TELOS_PYTHON=python3
TELOS_BRIDGE_MODULE=telos.bridge

# Security: destructive tools (delete_model) are not even advertised to the
# client unless this is set.
ALLOW_DESTRUCTIVE_TOOLS=0

# Optional: override the local storage root.
# MCP_LOCAL_LLM_STORAGE_DIR=/tmp/mcp-local-llm-dev

# Optional: override the secondary redacted audit-log directory.
# MCP_LOCAL_LLM_TELEMETRY_DIR=/tmp/mcp-local-llm-telemetry
